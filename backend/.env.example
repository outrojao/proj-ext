# .env — template SEM segredos (seguro para git).
# Copie para .env e preencha:  cp .env.example .env  (ou: make install)

# Banco — connection string do Postgres.
# Produção: a pooled do Neon (a de -pooler, com ?sslmode=require)
DATABASE_URL=

# API Keys por cliente — em produção, valores REAIS e DIFERENTES entre si.
# A de admin é a mais privilegiada (muta cardápio e status).
API_KEY_PWA_CLIENTE=
API_KEY_PWA_ADMIN=
API_KEY_ESP32=

# Configuração Pix — com chave real o QR vira pagamento REAL (sem gateway:
# quem marca PAGO é o atendente no admin PWA)
PIX_CHAVE=
PIX_NOME=
PIX_CIDADE=

# Tempo (minutos) que um pedido PRONTO fica no painel LCD antes da fila
# rotacionar. Opcional — padrão: 10
PAINEL_TIMEOUT_MINUTOS=

# Upload de imagens do cardápio → Cloudflare R2
# R2_SECRET_ACCESS_KEY: do Create API token — NUNCA commitar/colar em lugar nenhum
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=

# Origens autorizadas a chamar a API, separadas por vírgula, sem espaço.
# OPCIONAL — sem a variável fica liberado (*) para desenvolvimento local.
# Produção: CORS_ORIGINS=https://<pwa-cliente>,https://<pwa-admin>
#CORS_ORIGINS=

# Rotas /test/* (seed/cenário/limpar banco) — SÓ no dev; descomente para
# desenvolver localmente. NÃO definir em produção.
#EXPOSE_TEST_ROUTES=1

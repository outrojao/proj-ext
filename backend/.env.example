DATABASE_URL=postgresql://link

# API Keys por cliente (gere strings aleatórias seguras)
API_KEY_PWA=sua-chave-pwa-aqui
API_KEY_APP=sua-chave-app-mobile-aqui
API_KEY_ESP32=sua-chave-esp32-aqui

# Configuração Pix (dados do recebedor usados no QR Code)
PIX_CHAVE=sua-chave-pix-aqui
PIX_NOME=Nome Do Recebedor
PIX_CIDADE=Cidade

# Tempo (minutos) que um pedido fica exibido no painel LCD antes de a fila
# rotacionar (apenas se houver outro pedido PRONTO aguardando)
PAINEL_TIMEOUT_MINUTOS=10